% =============================================================================
%  BASE DE HECHOS - Red troncal simplificada de TransMilenio (Bogotá)
% =============================================================================
%  Sintaxis tipo Datalog/Prolog:
%     predicado(arg1, arg2, ...).        % las cadenas van entre comillas
%     % Esto es un comentario
%
%  IMPORTANTE: es un modelo académico. Incluye 7 troncales y ~85 estaciones.
%  Las coordenadas son APROXIMADAS (sirven para estimar tiempos y para la
%  heurística). Pueden reemplazarse por las del portal de datos abiertos de
%  TransMilenio sin cambiar una sola línea de código.
% =============================================================================

% --- Parámetros del modelo ----------------------------------------------------
parametro("velocidad_comercial_kmh", 25).   % velocidad promedio de un bus troncal
parametro("tiempo_parada_min", 0.5).        % detención en cada estación
parametro("tiempo_transbordo_min", 5).      % caminar dentro de la estación + esperar

% --- Troncales -----------------------------------------------------------------
troncal("A", "Caracas").
troncal("B", "Autopista Norte").
troncal("D", "Calle 80").
troncal("E", "NQS Central").
troncal("F", "Américas").
troncal("J", "Eje Ambiental").
troncal("K", "Calle 26").

% --- Portales ------------------------------------------------------------------
portal("Portal Norte").
portal("Portal 80").
portal("Portal Américas").
portal("Portal El Dorado").

% --- siguiente(EstacionA, EstacionB, Troncal): A y B son consecutivas ----------
%     (la regla R1/R2 las vuelve bidireccionales)

% Troncal B - Autopista Norte (norte -> sur)
siguiente("Portal Norte", "Toberín", "B").
siguiente("Toberín", "Calle 161", "B").
siguiente("Calle 161", "Mazurén", "B").
siguiente("Mazurén", "Calle 146", "B").
siguiente("Calle 146", "Calle 142", "B").
siguiente("Calle 142", "Alcalá", "B").
siguiente("Alcalá", "Prado", "B").
siguiente("Prado", "Calle 127", "B").
siguiente("Calle 127", "Pepe Sierra", "B").
siguiente("Pepe Sierra", "Calle 106", "B").
siguiente("Calle 106", "Calle 100", "B").
siguiente("Calle 100", "Virrey", "B").
siguiente("Virrey", "Calle 85", "B").
siguiente("Calle 85", "Héroes", "B").

% Troncal A - Caracas (norte -> centro)
siguiente("Héroes", "Calle 76", "A").
siguiente("Calle 76", "Calle 72", "A").
siguiente("Calle 72", "Flores", "A").
siguiente("Flores", "Calle 63", "A").
siguiente("Calle 63", "Calle 57", "A").
siguiente("Calle 57", "Marly", "A").
siguiente("Marly", "Calle 45", "A").
siguiente("Calle 45", "Av. 39", "A").
siguiente("Av. 39", "Calle 34", "A").
siguiente("Calle 34", "Calle 26", "A").
siguiente("Calle 26", "Calle 22", "A").
siguiente("Calle 22", "Calle 19", "A").
siguiente("Calle 19", "Av. Jiménez", "A").
siguiente("Av. Jiménez", "Tercer Milenio", "A").

% Troncal D - Calle 80 (occidente -> oriente)
siguiente("Portal 80", "Quirigua", "D").
siguiente("Quirigua", "Carrera 90", "D").
siguiente("Carrera 90", "Av. Ciudad de Cali", "D").
siguiente("Av. Ciudad de Cali", "Granja - Carrera 77", "D").
siguiente("Granja - Carrera 77", "Minuto de Dios", "D").
siguiente("Minuto de Dios", "Av. Boyacá", "D").
siguiente("Av. Boyacá", "Ferias", "D").
siguiente("Ferias", "Av. 68", "D").
siguiente("Av. 68", "Carrera 53", "D").
siguiente("Carrera 53", "Carrera 47", "D").
siguiente("Carrera 47", "Escuela Militar", "D").
siguiente("Escuela Militar", "Polo", "D").
siguiente("Polo", "Héroes", "D").

% Troncal E - NQS Central (norte -> sur)
siguiente("Calle 100", "La Castellana", "E").
siguiente("La Castellana", "NQS Calle 75", "E").
siguiente("NQS Calle 75", "Av. Chile", "E").
siguiente("Av. Chile", "7 de Agosto", "E").
siguiente("7 de Agosto", "Movistar Arena", "E").
siguiente("Movistar Arena", "Campín", "E").
siguiente("Campín", "U. Nacional", "E").
siguiente("U. Nacional", "Av. El Dorado", "E").
siguiente("Av. El Dorado", "CAD", "E").
siguiente("CAD", "Paloquemao", "E").
siguiente("Paloquemao", "Ricaurte", "E").
% Interconector de la Calle 80: los servicios de la NQS entran a la Calle 80
% a la altura de Escuela Militar (se modela como un tramo de la troncal E).
siguiente("NQS Calle 75", "Escuela Militar", "E").

% Troncal F - Américas (centro -> occidente)
siguiente("Av. Jiménez", "De La Sabana", "F").
siguiente("De La Sabana", "San Façón - Carrera 22", "F").
siguiente("San Façón - Carrera 22", "Ricaurte", "F").
siguiente("Ricaurte", "CDS - Carrera 32", "F").
siguiente("CDS - Carrera 32", "Zona Industrial", "F").
siguiente("Zona Industrial", "Carrera 43", "F").
siguiente("Carrera 43", "Puente Aranda", "F").
siguiente("Puente Aranda", "Distrito Grafiti", "F").
siguiente("Distrito Grafiti", "Pradera", "F").
siguiente("Pradera", "Marsella", "F").
siguiente("Marsella", "Américas - Av. Boyacá", "F").
siguiente("Américas - Av. Boyacá", "Mandalay", "F").
siguiente("Mandalay", "Banderas", "F").
siguiente("Banderas", "Transversal 86", "F").
siguiente("Transversal 86", "Biblioteca Tintal", "F").
siguiente("Biblioteca Tintal", "Patio Bonito", "F").
siguiente("Patio Bonito", "Portal Américas", "F").

% Troncal J - Eje Ambiental
siguiente("Av. Jiménez", "Museo del Oro", "J").
siguiente("Museo del Oro", "Las Aguas", "J").

% Troncal K - Calle 26 (occidente -> centro)
siguiente("Portal El Dorado", "Modelia", "K").
siguiente("Modelia", "Normandía", "K").
siguiente("Normandía", "Av. Rojas", "K").
siguiente("Av. Rojas", "El Tiempo - Maloka", "K").
siguiente("El Tiempo - Maloka", "Salitre - El Greco", "K").
siguiente("Salitre - El Greco", "CAN", "K").
siguiente("CAN", "Gobernación", "K").
siguiente("Gobernación", "Quinta Paredes", "K").
siguiente("Quinta Paredes", "Corferias", "K").
siguiente("Corferias", "Ciudad Universitaria", "K").
siguiente("Ciudad Universitaria", "Concejo de Bogotá", "K").
siguiente("Concejo de Bogotá", "Centro Memoria", "K").
siguiente("Centro Memoria", "Universidades", "K").

% --- Conexiones peatonales entre estaciones (minutos a pie) --------------------
conexion_peatonal("Universidades", "Las Aguas", 4).   % túnel peatonal

